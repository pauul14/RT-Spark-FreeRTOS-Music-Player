# Publication allowlist: unknown root files remain private by default.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES.md
!/LICENSES/
!/platformio.ini
!/freertos_build.py
!/src/
!/include/

# Only reviewed source, headers and license documents.
/src/*
!/src/main.cpp
!/src/checkpoint_ui.c
/include/*
!/include/FreeRTOSConfig.h
!/include/checkpoint_ui.h
!/include/player_ui_assets.h
!/include/player_ui_font_LICENSE.txt
!/include/custom_songs.h
/LICENSES/*
!/LICENSES/Apache-2.0.txt
!/LICENSES/ST-CubeMX-2018-NOTICE.txt
!/LICENSES/Demonstration-MIT.txt

# Non-public song data remains excluded.
/include/song.h
/include/song_def.h
/include/favorites_songs.h

# Keep build artifacts, original flash, checkpoints and experiments local.
/.pio/
/.vscode/
/backup/
/reference/
/tools/
/test/
/lib/
**/__pycache__/
*.py[cod]
*.elf
*.bin
*.hex
*.map
*.o
*.a
*.d
*.mid
*.midi
*.wav
*.csv
*.log
*.tmp
*.bak
*.zip
*.7z

# Credentials, local environments and operating-system files.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.keystore
credentials*
secrets*
.venv/
venv/
.DS_Store
Thumbs.db
Desktop.ini
